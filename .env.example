# Default provider when the app opens: ollama or openrouter
FIXLENS_PROVIDER=ollama

# Local Ollama
FIXLENS_MODEL=llama3.2-vision
OLLAMA_HOST=http://localhost:11434
FIXLENS_TIMEOUT_SECONDS=180

# Hosted OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-scout:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1